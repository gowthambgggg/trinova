
{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/api.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/api.php",
      "dest": "/api/api.php"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|svg|ico|woff2?))$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
